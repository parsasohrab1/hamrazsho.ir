// Hamraz backend data model.
//
// Deliberately minimal by design: instead of a hand-normalized table per
// client feature (20+ and growing), UserData is a generic per-user
// key-value store that mirrors the AsyncStorage keys the client already
// uses (see mental-wellness-assistant/src/state/use*.ts). This gets every
// existing feature centralized storage + cross-device sync without a
// slow, error-prone one-schema-per-feature migration effort. If a
// specific feature later needs real relational queries (e.g. searching
// across all users' mood logs for analytics), split that one key out into
// its own table then — this generic store is the pragmatic starting
// point, not a permanent constraint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  data      UserData[]
  files     UserFile[]
  purchases Purchase[]
  orders    PaymentOrder[]

  @@map("users")
}

/// One row per (user, key) — e.g. key = "mind_companion_mood_log_v1".
/// `value` holds exactly what the client would otherwise keep in
/// AsyncStorage for that key, as JSON.
model UserData {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_data")
}

/// Uploaded files (currently: style-advisor self/wardrobe photos).
/// `storageKey` is an opaque path/key handed to the active StorageProvider
/// (local disk by default — see src/services/storageProvider.ts); it is
/// never a public URL by itself.
model UserFile {
  id         String   @id @default(uuid())
  userId     String
  key        String // caller-assigned label, e.g. "style_selfie" — not unique, a user can have many
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_files")
}

/// Shared, read-only advisory content (legal-consultation topics,
/// mental-health awareness topics, ...) — NOT per-user data, unlike
/// UserData above. One row per topic; every user reads the same set via
/// GET /skills/:skill. Seeded from scripts/seedSkillContent.ts, sourced
/// from the same content shipped bundled in the client
/// (mental-wellness-assistant/src/data/legalTopics.ts and
/// mentalHealthTopics.ts) so the app keeps working fully offline even
/// though this table also exists as a centralized, updatable copy.
model SkillContent {
  id        String   @id @default(uuid())
  skill     String // "legal" | "mental_health" — matches the client's AdvisorySkill type
  day       Int
  title     String
  hook      String
  points    Json // string[]
  cta       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skill, day])
  @@index([skill])
  @@map("skill_content")
}

/// Short-lived OTP codes for phone login. Only a bcrypt hash of the code
/// is stored, never the plaintext code itself.
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

/// A verified premium entitlement grant. One row per verified store
/// purchase / web payment. The user's premium status is derived from these
/// rows (latest non-revoked `expiresAt` in the future) — see
/// src/billing/entitlement.ts. `userId` is nullable + SetNull on delete:
/// when a user deletes their account we remove every personal row, but
/// financial records of a completed payment must be kept for accounting/tax
/// (and for store refund disputes), detached from the deleted identity.
model Purchase {
  id            String    @id @default(uuid())
  userId        String?
  provider      String // "bazaar" | "myket" | "zarinpal" | "manual"
  planId        String // see src/billing/plans.ts
  productId     String // store SKU (or planId for web payments)
  /// Store purchase token, or Zarinpal authority — unique so the same
  /// receipt can never be redeemed twice (or by two accounts).
  purchaseToken String    @unique
  orderId       String?
  startsAt      DateTime
  expiresAt     DateTime
  autoRenewing  Boolean   @default(false)
  revokedAt     DateTime?
  raw           Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("purchases")
}

/// A pending/finished web (Zarinpal) checkout. A Purchase row is created
/// only after the gateway's server-side verify call succeeds.
model PaymentOrder {
  id         String    @id @default(uuid())
  userId     String?
  planId     String
  amountRial Int
  authority  String    @unique
  status     String    @default("pending") // "pending" | "paid" | "failed"
  refId      String?
  cardPan    String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payment_orders")
}
