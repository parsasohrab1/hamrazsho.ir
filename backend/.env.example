# Copy this file to .env and fill in real values before running.

# PostgreSQL connection string (docker-compose.yml provides a matching local instance).
DATABASE_URL="postgresql://yavar:yavar_dev_password@localhost:5432/yavar?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT signing secrets — generate real random 32+ byte values for production,
# e.g. `openssl rand -hex 32`. NEVER reuse the placeholders below outside
# local development.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SEC=60

# SMS provider: "console" (default, dev-only — logs/returns the code
# instead of sending it; see src/services/smsProvider.ts) or "kavenegar"
# (real SMS delivery — requires KAVENEGAR_API_KEY, and the server refuses
# to start with provider=kavenegar if the key is missing).
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER_LINE=

# File storage: "local" (default — saves under ./uploads) or "s3" (stub,
# not implemented — see src/services/storageProvider.ts).
STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=8
