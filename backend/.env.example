# Copy this file to .env and fill in real values before running.

# PostgreSQL connection string (docker-compose.yml provides a matching local instance).
DATABASE_URL="postgresql://hamraz:hamraz_dev_password@localhost:5432/hamraz?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT signing secrets — generate real random 32+ byte values for production,
# e.g. `openssl rand -hex 32`. NEVER reuse the placeholders below outside
# local development.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SEC=60

# SMS provider: "console" (default, dev-only — logs/returns the code
# instead of sending it; see src/services/smsProvider.ts) or "kavenegar"
# (real SMS delivery — requires KAVENEGAR_API_KEY, and the server refuses
# to start with provider=kavenegar if the key is missing).
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER_LINE=

# File storage: "local" (default — saves under ./uploads) or "s3" (stub,
# not implemented — see src/services/storageProvider.ts).
STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=8

# ---- Production hardening ----
# Comma-separated browser origins allowed to call the API (web/PWA build),
# e.g. https://hamrazsho.ir,https://www.hamrazsho.ir. Empty = any origin (dev only).
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 behind nginx/Caddy/Arvan).
TRUST_PROXY=0

# ---- Billing / subscriptions (see README "Payments") ----
# Must equal the Android package in mental-wellness-assistant/app.config.ts.
APP_PACKAGE_NAME=ir.hamrazsho.app
# Cafe Bazaar: Pishkhan panel → API token. Server-side only, never in the app.
BAZAAR_API_SECRET=
# Myket: developer panel → in-app products → verification token.
MYKET_ACCESS_TOKEN=
# Zarinpal (web/PWA checkout). Keep ZARINPAL_SANDBOX=true until go-live.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Web checkout prices, in Rial (1 Toman = 10 Rial).
PRICE_MONTHLY_RIAL=1490000
PRICE_YEARLY_RIAL=11900000
# Public URL of this API (Zarinpal redirects the browser back here).
PUBLIC_API_URL=http://localhost:4000
# Where the browser is sent after a web payment finishes.
WEB_APP_URL=http://localhost:8081
